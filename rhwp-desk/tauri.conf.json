{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rhwp-desk",
  "version": "0.8.8",
  "identifier": "kr.rhwp.desk",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "rhwp - 한글/워드 프로세서",
        "width": 1480,
        "height": 920,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "appimage",
      "deb"
    ],
    "resources": [
      "bin/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": ["hwp"],
        "name": "HWP 문서",
        "description": "한글 워드프로세서 문서 (HWP5)",
        "role": "Viewer"
      },
      {
        "ext": ["hwpx"],
        "name": "HWPX 문서",
        "description": "개방형 한글 문서 (OWPML)",
        "role": "Viewer"
      }
    ]
  }
}
